{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2-c1-evidence/1",
  "title": "V2-C1 registered evidence record",
  "type": "object",
  "required": ["schema", "campaign", "run_id", "order_index", "utc", "env", "regime", "backend", "circuit", "k", "relation", "proof_id", "op", "role", "status", "artifacts"],
  "properties": {
    "schema": {"const": "v2-c1-evidence/1"},
    "campaign": {"type": "string", "pattern": "^(PILOT|FULL|BRIDGE|AMENDMENT-[A-Za-z0-9-]+)$"},
    "run_id": {"type": "string"},
    "order_index": {"type": "integer", "minimum": 0},
    "utc": {"type": "string"},
    "env": {"enum": ["evm-osaka", "evm-petersburg", "eravm-29", "eravm-27", "zkos-v32"]},
    "regime": {"type": "object"},
    "backend": {"enum": ["groth16", "plonk", "fflonk"]},
    "circuit": {"type": "string", "pattern": "^c1_"},
    "k": {"type": "integer", "minimum": 1},
    "relation": {"enum": ["ctx", "a4", "a8", "disc"]},
    "proof_id": {"type": ["string", "null"]},
    "op": {"enum": ["deploy_verifier", "deploy_manager", "set_issuer", "add_root", "verify_credential", "verify_proof_direct", "control"]},
    "control": {"type": ["string", "null"]},
    "role": {"enum": ["measurement", "control", "replay", "setup"]},
    "status": {"enum": [0, 1]},
    "returned": {"enum": ["true", "false", "revert", null]},
    "tx_hash": {"type": ["string", "null"]},
    "gas_used": {"type": ["integer", "null"]},
    "calldata_bytes": {"type": ["integer", "null"]},
    "calldata_zero": {"type": ["integer", "null"]},
    "evm_trace": {"type": ["object", "null"], "required": ["gas", "ops", "precompiles", "keccak_sizes", "copies"]},
    "eravm": {"type": ["object", "null"], "required": ["computational_gas"]},
    "zkos": {"type": ["object", "null"], "required": ["computational_native", "native_used", "pubdata_used", "effective_gas_price"]},
    "artifacts": {"type": "object", "required": ["verifier_runtime_sha256", "proof_file_sha256", "pins_sha256"]},
    "deviation_ref": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]}
  }
}
